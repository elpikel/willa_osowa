# This file excludes paths from the Docker build context.

.dockerignore

# Ignore git, but keep git HEAD and refs to access the current commit hash:
.git
!.git/HEAD
!.git/refs

# Common development/test artifacts
/cover/
/doc/
/test/
/tmp/
.elixir_ls

# Mix artifacts
/_build/
/deps/
*.ez

# Generated on crash by the VM
erl_crash.dump

# Leftover from the previous nginx setup
nginx.conf

# NOTE: priv/static (index.html + assets) is the actual site and MUST be
# included in the build — do not exclude it.
